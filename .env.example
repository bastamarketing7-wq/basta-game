# BASTA Diagnosis Engine — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env وعبّئ القيم الحقيقية عند الحاجة.
# لا تضع أي مفتاح حقيقي داخل هذا الملف ولا داخل المستودع.

# التخزين: local = تخزين محلي منظّم داخل المتصفح (الوضع الافتراضي للنسخة الأولى)
VITE_STORAGE_DRIVER=local

# تكاملات اختيارية لمرحلة لاحقة. اتركها فارغة ما لم يتم اعتماد التكامل فعليًا.
# عند تركها فارغة يعرض النظام حالة: يحتاج إدخالًا يدويًا أو ربط API
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
VITE_META_GRAPH_API_TOKEN=

# نقطة نهاية خلفية اختيارية إن تم نقل التخزين لقاعدة بيانات لاحقًا
VITE_API_BASE_URL=
